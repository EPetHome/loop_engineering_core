#!/usr/bin/env bash
# Loop：开发卡、单会话、只评审与维护。实现见 ../loop.ts。
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# 接入与开发参数由各自实现解析，不经过批次选项解析器。
if [[ "${1:-}" == "接入" ]]; then
  shift
  exec node "$here/setup-acceptance.ts" "$@"
fi
if [[ "${1:-}" == "开发" ]]; then
  # 单会话只有开发评审；旧环境不能重新接入已删除的流水线。
  export AUTOREVIEW_SINGLE_NODE=1
  unset AUTOREVIEW_BATCH_FILE AUTOREVIEW_STAGE AUTOREVIEW_PIPELINE_DIR AUTOREVIEW_PIPELINE_LAUNCH AUTOREVIEW_PIPELINE_LAUNCH_TOKEN AUTOREVIEW_BASE_REV
  shift
  host="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "$host" in
    pi) exec "$here/bin/pi-dev" "$@" ;;
    claude|codex) exec "$here/bin/loop-dev" "$host" "$@" ;;
    *) echo '用法：loop 开发 <pi|claude|codex> [原开发入口参数…]' >&2; exit 2 ;;
  esac
fi
exec node "$here/loop.ts" "$@"
