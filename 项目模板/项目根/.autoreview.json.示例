{
  "release": "main",
  "workspaces": {
    "dev分支": "../<仓库目录名>-dev分支"
  },
  "localFiles": [
    "deploy/acceptance/start.sh",
    "deploy/acceptance/reset-data.sh",
    "deploy/acceptance/release.sh",
    "deploy/acceptance/GUIDE.md"
  ],
  "methods": {
    "paths": [
      ".autoreview/methods"
    ],
    "selfCheck": "sh .autoreview/methods/self-check.sh",
    "probe": "node -v"
  },
  "reviewTimeoutMin": 90,
  "gate": {
    "cmd": "sh .autoreview/methods/gate.sh check",
    "timeoutMin": 35
  },
  "acceptance": {
    "start": "sh deploy/acceptance/start.sh",
    "readyUrl": "http://127.0.0.1:38081/actuator/health",
    "env": {
      "PORT": "38081"
    },
    "reset": "sh deploy/acceptance/reset-data.sh",
    "guide": "deploy/acceptance/GUIDE.md",
    "timeoutMin": 30,
    "cleanup": "sh deploy/acceptance/release.sh"
  },
  "preparation": {
    "check": "sh .autoreview/methods/prepare.sh check",
    "recover": "sh .autoreview/methods/prepare.sh recover",
    "timeoutMin": 5,
    "maxRecoveries": 1,
    "maxRepairs": 1
  },
  "context": {
    "root": ".",
    "sources": [
      {
        "id": "rules",
        "path": "AGENTS.md",
        "role": "rules"
      },
      {
        "id": "need",
        "path": "docs/requirements/需求-示例.md",
        "role": "requirement"
      },
      {
        "id": "design",
        "path": "docs/prompt/方案-示例.md",
        "role": "design",
        "dependsOn": [
          "need"
        ]
      },
      {
        "id": "methods",
        "path": ".autoreview/methods",
        "role": "guide",
        "dependsOn": [
          "design"
        ]
      }
    ],
    "intervalSec": 0
  }
}
