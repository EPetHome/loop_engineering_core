  "units": [
    {
      "id": "cards",
      "goal": "实现并验证一张本机空壳卡片的生成、启停状态和真实WorkBuddy桌面操作，保留可追溯结果。",
      "depends_on": [],
      "criteria": [
        {
          "id": "S1",
          "text": "生成一座本机目录市场和一张只有必要清单的空壳卡片，名称、简介、版本正确，不带技能、代码、钩子或MCP服务。",
          "gate_ids": [
            "G1"
          ]
        },
        {
          "id": "S2",
          "text": "重复生成、改名、1.0.0升级到1.0.1保持同一资源身份，不产生重复卡片；非法路径、符号链接及未知归属不得覆盖，更新失败保留旧输出。",
          "gate_ids": [
            "G1"
          ]
        },
        {
          "id": "S3",
          "text": "只读识别未安装、启用、停用、卸载及版本；不可读、损坏、矛盾和归属异常不误报成功或未安装，查询不改变任何状态。",
          "gate_ids": [
            "G1"
          ]
        },
        {
          "id": "S4",
          "text": "在独立且经过边界确认的真实WorkBuddy桌面中完成市场可见、安装、停用、启用、卸载、再次安装、同身份升级；每步有原始宿主输出/状态和实际桌面截图，不能用CLI/headless或自写登记代替。",
          "gate_ids": [
            "G2"
          ]
        },
        {
          "id": "S5",
          "text": "宿主测试执行当前冻结候选的代码，证据和截图属于本次操作；其他市场、插件、用户资料未改变，本次受管进程完成清理，原始证据及恢复材料保留。",
          "gate_ids": [
            "G2"
          ]
        },
        {
          "id": "S6",
          "text": "实现仅在 experiments/ecosystem-cards/，原插件、原测试、验收脚本和规则未被修改，不发布或合并；附简短使用说明、已验证和未验证项。",
          "gate_ids": []
        },
        {
          "id": "S7",
          "text": "评审独立阅读候选和原始门禁证据，逐条判断真实性、边界与结果，不只复述开发自评；无法证明桌面状态、当前候选或资源保护时标UNKNOWN/FAIL。",
          "gate_ids": []
