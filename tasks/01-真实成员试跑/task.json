{
  "schema_version": 1,
  "task_id": "trial-01",
  "title": "真实成员试跑：Sol 开发、Astra 评审（邀请重发示例）",
  "source": "project",
  "agents": {
    "dev": {
      "kind": "command",
      "identity": "sol-developer",
      "output": "stdout",
      "inherit_env": [],
      "argv": [
        "{python}",
        "/Users/Admin/Desktop/Loop/adapters/pi_member.py",
        "--model",
        "openai-codex/gpt-6.1-sol",
        "--thinking",
        "max",
        "--tools",
        "read,bash,edit,write,grep,find,ls"
      ]
    },
    "review": {
      "kind": "command",
      "identity": "astra-reviewer",
      "output": "stdout",
      "inherit_env": [],
      "argv": [
        "{python}",
        "/Users/Admin/Desktop/Loop/adapters/pi_member.py",
        "--model",
        "openai-codex/gpt-6-astra",
        "--thinking",
        "xhigh",
        "--tools",
        "read,grep,find,ls"
      ]
    }
  },
  "limits": {
    "max_wall_seconds": 3000,
    "max_member_invocations": 10
  },
  "notes": "第一次用真实成员跑循环，目的是确认成员能在循环里正常交付。只改示例副本，不接任何外部服务。【交付格式，务必照做】criteria 里的 evidence 数组只能写两种引用：code:<被审项目内的相对路径>（例如 code:invites.py），或 gate:<门禁ID>（例如 gate:G1）。开发方不要写 gate: 引用，门禁由引擎在你交付之后才运行，你自己跑过测试请写在 note 里。评审方可以写 gate: 引用。任何其他内容都不要放进 evidence：绝对路径、工作区里的 input.json 或 candidate 文件、网址、日志路径，一律写在 note 里说明即可。",
  "units": [
    {
      "id": "invite",
      "goal": "修复邀请重新发送判断：仅 pending 且 expired 为真时允许重发。",
      "depends_on": [],
      "writable_paths": [
        "invites.py"
      ],
      "protected_paths": [
        "tests/",
        "baseline.md"
      ],
      "developer": "dev",
      "reviewer": "review",
      "max_repairs": 1,
      "max_infra_retries": 1,
      "max_protocol_retries": 3,
      "stage_timeout_seconds": 900,
      "max_seconds": 2700,
      "criteria": [
        {
          "id": "S1",
          "text": "四个冻结用例全部通过，只有待接受且已过期的邀请可以重发。",
          "gate_ids": [
            "G1"
          ]
        },
        {
          "id": "S2",
          "text": "修改仅涉及 invites.py；代码与目标一致。",
          "gate_ids": []
        }
      ],
      "gates": [
        {
          "id": "G1",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ],
          "timeout_seconds": 30
        }
      ]
    }
  ]
}