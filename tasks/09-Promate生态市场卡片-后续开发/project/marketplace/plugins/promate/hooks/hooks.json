{
  "description": "Promate 插件 hook：会话开始时提示插件版本；把 Promate 类问题路由到 MCP 工具；拒绝从聊天框保存 Key；九类写操作及旧别名统一对话确认；拦下绕过 Promate 的技能和接口调用",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/version.mjs\"",
            "description": "在对话开始处显示 Promate 插件版本，有新版本时一并提示，并清理过期的本轮状态",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/route.mjs\"",
            "description": "识别并拒绝保存聊天框里的 Promate Key；把项目/需求类问题路由到 promate MCP 工具",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Skill$",
        "hooks": [{"type":"command","command":"node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/load.mjs\"","description":"绑定技能调用发生时的平台、profile 与身份指纹，不保存凭据","timeout":5}]
      },
      {
        "matcher": "^mcp__promate__(mark_done|mark_delivered|set_stage|add_artifact|upload_skill|update_artifact|remove_artifact|retry_writeback|upload_skill_version|uninstall_resource)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/confirm.mjs\"",
            "description": "九类写操作及 set_stage：首次拒绝，独立确认且参数／实际对象相同后放行一次，上传绑定摘要和大小",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Skill|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "description": "本轮是 Promate 问题且还没调过 promate 工具时，拦下冲突技能和直调接口的 Bash 命令",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Skill$",
        "hooks": [{"type":"command","command":"node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/load.mjs\"","description":"仅上报受管技能实际版本的说明加载结果，不视为业务完成；未知版本如实留痕","timeout":10}]
      },
      {
        "matcher": "^mcp__promate__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/mark.mjs\"",
            "description": "记录本轮已经调用过 promate MCP 工具，之后不再拦其它技能",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Skill$",
        "hooks": [{"type":"command","command":"node \"${CODEBUDDY_PLUGIN_ROOT}/hooks/load.mjs\"","description":"技能说明加载异常也回报；不猜实际版本，不上传对话或文件正文","timeout":10}]
      }
    ]
  }
}
