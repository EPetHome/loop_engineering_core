{
  "schema_version": 1,
  "task_id": "invite-demo",
  "title": "离线演示：成员邀请过期重发",
  "source": "demo_project",
  "agents": {
    "dev": {
      "kind": "command",
      "identity": "offline-developer",
      "argv": [
        "{python}",
        "{engine}/examples/demo_member.py",
        "--context",
        "{context}",
        "--mode",
        "repair"
      ],
      "output": "file"
    },
    "review": {
      "kind": "command",
      "identity": "offline-reviewer",
      "argv": [
        "{python}",
        "{engine}/examples/demo_member.py",
        "--context",
        "{context}",
        "--mode",
        "repair"
      ],
      "output": "file"
    }
  },
  "limits": {
    "max_wall_seconds": 120,
    "max_member_invocations": 12
  },
  "units": [
    {
      "id": "invite",
      "goal": "修复邀请重新发送判断：仅 pending 且 expired 为真时允许重发。",
      "depends_on": [],
      "writable_paths": [
        "invites.py"
      ],
      "protected_paths": [
        "tests/",
        "baseline.md"
      ],
      "developer": "dev",
      "reviewer": "review",
      "max_repairs": 2,
      "max_infra_retries": 0,
      "max_protocol_retries": 1,
      "stage_timeout_seconds": 15,
      "max_seconds": 90,
      "criteria": [
        {
          "id": "S1",
          "text": "四个冻结用例全部通过，只有待接受且已过期的邀请可以重发。",
          "gate_ids": [
            "G1"
          ]
        },
        {
          "id": "S2",
          "text": "修改仅涉及 invites.py；代码与目标一致。",
          "gate_ids": []
        }
      ],
      "gates": [
        {
          "id": "G1",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ],
          "timeout_seconds": 10
        }
      ]
    }
  ]
}
