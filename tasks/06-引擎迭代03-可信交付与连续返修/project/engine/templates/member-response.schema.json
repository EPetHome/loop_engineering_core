{
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "developer",
        "reviewer"
      ]
    },
    "candidate_hash": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "blocked": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "status",
          "note",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "description",
          "suggested_fix"
        ],
        "additionalProperties": false
      }
    },
    "rule_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "attempt_id",
    "role",
    "candidate_hash",
    "summary",
    "blocked",
    "criteria",
    "issues",
    "rule_gaps"
  ],
  "additionalProperties": false
}
